# Images only — no script execution, no listing
Options -Indexes -ExecCGI
RemoveHandler .php .phtml .phar .pl .py .cgi .sh
RemoveType .php .phtml .phar
<FilesMatch "\.(php|phtml|phar|pl|py|cgi|sh|htaccess)$">
  Require all denied
</FilesMatch>
<FilesMatch "\.(jpe?g|png|webp|gif)$">
  Require all granted
</FilesMatch>
